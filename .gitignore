# Rust build output
target/

# Save files and anything extracted from them stay out of the repo
*.sav
*.sav.*
# Windows and macOS name files without regard to case
*.[sS][aA][vV]
*.[sS][aA][vV].*
*.zst
*.bin
*.raw
*.dump
saves/
scratch/
previews/

# Images: the game's .jpg next to each save, extracted previews.
*.jpg
*.jpeg
*.webp

# Rendered maps are pictures of other people's saves. Only our own
# diagrams under docs/images/ are tracked.
*.svg
!docs/images/*.svg
*.png
*.[pP][nN][gG]
!docs/images/*.png
# A killed run leaves its temporary map beside the output
*.tmp
# Our own pictograms, drawn in tf3-save-format, embedded in the tool.
!crates/tf3-save-mapper-core/icons/**/*.svg
out/
output/

# Local-only notes and lists (paths to saves on this machine)
local/

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
